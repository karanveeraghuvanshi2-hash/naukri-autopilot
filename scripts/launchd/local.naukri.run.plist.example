<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- One scheduled /naukri-run slot, filled in by `./naukri schedule`. The command
     is scripts/launchd/run.sh: it runs the gates, caps spend and time, and
     alerts on a crash. Schedule only after watching one real manual run.
     __TOOLPATH__ must come first: launchd's python3 is 3.9, and jobtool needs
     3.11+. No API-key or OAuth-token variables: either one turns Chrome off.
     Pause the schedules with `python3 scripts/jobtool.py hold on`, not by
     unloading them. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.naukri.__SLOT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT__/scripts/launchd/run.sh</string>
    <string>__SLOT__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__TOOLPATH__:/opt/homebrew/bin:__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__PROJECT__/data/logs/__SLOT__.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/data/logs/__SLOT__.log</string>
</dict>
</plist>
